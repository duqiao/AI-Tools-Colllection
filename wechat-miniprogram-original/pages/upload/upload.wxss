/* pages/upload/upload.wxss */

.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 20rpx;
}

/* Header Styles */
.header {
  margin-bottom: 30rpx;
}

.quota-info {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 12rpx;
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.quota-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.quota-plan {
  font-size: 24rpx;
  color: #666;
  background: #f0f0f0;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

/* File Selector Styles */
.file-selector {
  background: white;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 30rpx;
}

.upload-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.upload-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 30rpx;
}

.upload-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.upload-subtitle {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 60rpx;
}

.button-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
}

.btn-primary, .btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-radius: 12rpx;
  padding: 24rpx;
  border: none;
}

.btn-primary {
  background: linear-gradient(45deg, #4CAF50, #45a049);
  color: white;
  font-weight: 600;
}

.btn-secondary {
  background: #f5f5f5;
  color: #333;
  border: 2rpx solid #e0e0e0;
}

.btn-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

/* Supported Formats */
.supported-formats {
  margin-top: 40rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.formats-title {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}

.formats-list {
  font-size: 24rpx;
  color: #999;
}

/* File Preview */
.file-preview {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 30rpx;
}

.file-info {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.file-type-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
}

.file-details {
  flex: 1;
}

.file-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
  word-break: break-all;
}

.file-meta {
  font-size: 24rpx;
  color: #666;
  display: block;
}

.file-actions {
  display: flex;
  gap: 20rpx;
}

/* Progress Styles */
.upload-progress, .processing-status {
  background: white;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 30rpx;
}

.progress-header, .processing-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.progress-title, .processing-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.progress-percent {
  font-size: 28rpx;
  color: #4CAF50;
  font-weight: 600;
}

.progress-bar {
  width: 100%;
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(45deg, #4CAF50, #45a049);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.progress-status, .processing-subtitle {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.processing-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.processing-percent {
  font-size: 36rpx;
  font-weight: 600;
  color: #4CAF50;
  display: block;
  margin: 20rpx 0;
}

.processing-actions {
  margin-top: 40rpx;
}

/* Success State */
.success-state {
  background: white;
  border-radius: 20rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 30rpx;
}

.success-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 30rpx;
}

.success-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #4CAF50;
  margin-bottom: 16rpx;
}

.success-subtitle {
  font-size: 26rpx;
  color: #666;
}

/* Error State */
.error-state {
  background: white;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 30rpx;
}

.error-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 30rpx;
}

.error-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #f44336;
  margin-bottom: 16rpx;
}

.error-message {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 40rpx;
  line-height: 1.5;
}

.error-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* Upgrade Prompt */
.upgrade-prompt {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.prompt-content {
  background: white;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  margin: 40rpx;
  max-width: 600rpx;
}

.prompt-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 30rpx;
}

.prompt-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.prompt-message {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 40rpx;
}

.prompt-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* Button Active States */
.btn-primary:active {
  transform: scale(0.98);
  opacity: 0.8;
}

.btn-secondary:active {
  transform: scale(0.98);
  opacity: 0.8;
}

/* Responsive Design */
@media (max-width: 400px) {
  .container {
    padding: 15rpx;
  }
  
  .file-selector, .file-preview, .upload-progress, 
  .processing-status, .success-state, .error-state {
    padding: 40rpx 30rpx;
  }
  
  .upload-title, .processing-title, .error-title {
    font-size: 32rpx;
  }
  
  .button-group {
    gap: 15rpx;
  }
}