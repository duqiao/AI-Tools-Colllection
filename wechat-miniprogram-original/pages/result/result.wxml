<!-- pages/result/result.wxml -->
<view class="container">
  <!-- Loading State -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-content">
      <image class="loading-icon" src="/static/icons/loading.gif" mode="aspectFit"></image>
      <text class="loading-title">正在获取翻译结果</text>
      <text class="loading-subtitle">请稍候...</text>
    </view>
  </view>

  <!-- Error State -->
  <view class="error-state" wx:if="{{error}}">
    <image class="error-icon" src="/static/icons/error.png" mode="aspectFit"></image>
    <text class="error-title">获取结果失败</text>
    <text class="error-message">{{errorMessage}}</text>
    
    <view class="error-actions">
      <button class="btn-primary" bindtap="retryLoading">重试</button>
      <button class="btn-secondary" bindtap="goBack">返回</button>
    </view>
  </view>

  <!-- Translation Result -->
  <view class="result-container" wx:if="{{translationData && !loading && !error}}">
    <!-- Result Header -->
    <view class="result-header">
      <view class="file-info">
        <image class="file-type-icon" src="/static/icons/{{translationData.file_type}}.png" mode="aspectFit"></image>
        <view class="file-details">
          <text class="file-name">{{translationData.original_filename || '未知文件'}}</text>
          <text class="file-meta">
            {{translationData.word_count || 0}}字 · 
            置信度{{Math.round((translationData.confidence_score || 0) * 100)}}%
          </text>
        </view>
      </view>
      
      <view class="status-badge success">
        <text class="status-text">翻译完成</text>
      </view>
    </view>

    <!-- Text Result -->
    <view class="text-result">
      <view class="text-header">
        <text class="text-title">识别文本</text>
        <view class="text-actions">
          <button class="btn-icon" bindtap="startEditing" wx:if="{{!isEditing}}">
            <image class="icon" src="/static/icons/edit.png" mode="aspectFit"></image>
          </button>
          <button class="btn-icon" bindtap="copyText">
            <image class="icon {{copyingText ? 'animate' : ''}}" src="/static/icons/copy.png" mode="aspectFit"></image>
          </button>
        </view>
      </view>

      <!-- Text Display/Edit -->
      <view class="text-content">
        <!-- Display mode -->
        <view wx:if="{{!isEditing}}" class="text-display">
          <text class="transcribed-text">{{translationData.transcribed_text || '无识别内容'}}</text>
        </view>

        <!-- Edit mode -->
        <view wx:if="{{isEditing}}" class="text-edit">
          <textarea 
            class="text-textarea" 
            value="{{editedText}}" 
            bindinput="onTextInput"
            placeholder="请输入或编辑文本内容"
            maxlength="5000"
            auto-height
          ></textarea>
          
          <view class="edit-actions">
            <text class="char-count">{{editedText.length}}/5000</text>
            <view class="edit-buttons">
              <button class="btn-small btn-cancel" bindtap="cancelEdit">取消</button>
              <button class="btn-small btn-save" bindtap="saveEdit">保存</button>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- Translation Statistics -->
    <view class="translation-stats">
      <view class="stat-item">
        <text class="stat-value">{{translationData.word_count || 0}}</text>
        <text class="stat-label">字数</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{Math.round((translationData.confidence_score || 0) * 100)}}%</text>
        <text class="stat-label">置信度</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{translationData.processing_time || 0}}s</text>
        <text class="stat-label">处理时间</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{translationData.service_provider || '未知'}}</text>
        <text class="stat-label">服务商</text>
      </view>
    </view>

    <!-- Action Buttons -->
    <view class="action-buttons">
      <button class="btn-primary btn-large" bindtap="shareResult" loading="{{sharingResult}}">
        <image class="btn-icon" src="/static/icons/share.png" mode="aspectFit"></image>
        分享结果
      </button>
      
      <view class="secondary-actions">
        <button class="btn-secondary" bindtap="showTextDetails">
          <image class="btn-icon" src="/static/icons/info.png" mode="aspectFit"></image>
          详情
        </button>
        <button class="btn-secondary" bindtap="provideFeedback">
          <image class="btn-icon" src="/static/icons/feedback.png" mode="aspectFit"></image>
          反馈
        </button>
        <button class="btn-secondary" bindtap="reportIssue">
          <image class="btn-icon" src="/static/icons/report.png" mode="aspectFit"></image>
          报错
        </button>
      </view>
    </view>

    <!-- Navigation Options -->
    <view class="navigation-options">
      <button class="btn-outline" bindtap="uploadNew">
        <image class="btn-icon" src="/static/icons/upload.png" mode="aspectFit"></image>
        翻译新文件
      </button>
      <button class="btn-outline" bindtap="viewHistory">
        <image class="btn-icon" src="/static/icons/history.png" mode="aspectFit"></image>
        查看历史
      </button>
    </view>
  </view>
</view>