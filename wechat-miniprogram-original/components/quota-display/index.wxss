/* components/quota-display/index.wxss */

.quota-display {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin: 16rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 加载状态 */
.quota-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  flex-direction: column;
}

.loading-icon {
  font-size: 40rpx;
  margin-bottom: 16rpx;
}

.loading-text {
  color: #999;
  font-size: 24rpx;
}

/* 错误状态 */
.quota-error {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  flex-direction: column;
}

.error-icon {
  font-size: 40rpx;
  margin-bottom: 16rpx;
}

.error-text {
  color: #ff4757;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.retry-btn {
  background: #4CAF50;
  color: white;
  border: none;
  border-radius: 8rpx;
  font-size: 24rpx;
}

/* 简洁模式 */
.quota-simple {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.quota-main {
  display: flex;
  align-items: baseline;
  flex: 1;
}

.quota-remaining {
  font-size: 36rpx;
  font-weight: 700;
  color: #4CAF50;
  margin-right: 12rpx;
}

.quota-remaining.critical {
  color: #ff4757;
}

.quota-remaining.warning {
  color: #ffa502;
}

.quota-remaining.exhausted {
  color: #ff4757;
}

.quota-label {
  font-size: 24rpx;
  color: #666;
}

/* 状态指示器 */
.quota-status {
  flex: 1;
  margin: 0 20rpx;
}

.status-indicator {
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  text-align: center;
}

.status-indicator.normal {
  background: #e8f5e8;
}

.status-indicator.normal .status-text {
  color: #4CAF50;
  font-size: 22rpx;
}

.status-indicator.warning {
  background: #fff3cd;
}

.status-indicator.warning .status-text {
  color: #856404;
  font-size: 22rpx;
}

.status-indicator.critical {
  background: #f8d7da;
}

.status-indicator.critical .status-text {
  color: #721c24;
  font-size: 22rpx;
}

.status-indicator.exhausted {
  background: #f8d7da;
}

.status-indicator.exhausted .status-text {
  color: #721c24;
  font-size: 22rpx;
}

/* 操作按钮 */
.quota-actions {
  display: flex;
  gap: 12rpx;
}

.upgrade-btn {
  background: linear-gradient(45deg, #4CAF50, #45a049);
  color: white;
  border: none;
  border-radius: 8rpx;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  min-width: 80rpx;
}

.details-btn {
  background: #f8f9fa;
  color: #333;
  border: 1rpx solid #dee2e6;
  border-radius: 8rpx;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  min-width: 60rpx;
}

/* 详细模式 */
.quota-detailed {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 24rpx;
  margin-top: 16rpx;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.detail-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.close-btn {
  background: #f8f9fa;
  color: #666;
  border: none;
  border-radius: 50%;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  font-size: 24rpx;
  padding: 0;
}

.detail-content {
  background: #f8f9fa;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #e9ecef;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 26rpx;
  color: #666;
  flex: 1;
}

.detail-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  flex: 2;
  text-align: right;
}

.detail-value.critical {
  color: #ff4757;
  font-weight: 700;
}

.detail-value.warning {
  color: #ffa502;
  font-weight: 600;
}

.detail-actions {
  display: flex;
  gap: 16rpx;
  justify-content: center;
}

.detail-upgrade {
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  border-radius: 12rpx;
}

.refresh-btn {
  background: #6c757d;
  color: white;
  border: none;
  border-radius: 8rpx;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
}

/* 按钮点击效果 */
.upgrade-btn:active, .details-btn:active, .retry-btn:active, 
.close-btn:active, .refresh-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

/* 响应式设计 */
@media (max-width: 400rpx) {
  .quota-display {
    padding: 20rpx;
    margin: 12rpx 0;
  }
  
  .quota-simple {
    flex-direction: column;
    align-items: flex-start;
    gap: 16rpx;
  }
  
  .quota-status {
    margin: 0;
    width: 100%;
  }
  
  .quota-actions {
    width: 100%;
    justify-content: flex-end;
  }
  
  .detail-item {
    flex-direction: column;
    align-items: flex-start;
    gap: 8rpx;
  }
  
  .detail-value {
    text-align: left;
  }
}