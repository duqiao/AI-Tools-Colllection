/* pages/index/index.wxss */

.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 20rpx;
}

/* Header Section */
.header-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.header-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.app-logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 30rpx;
}

.app-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}

.app-subtitle {
  font-size: 26rpx;
  color: #666;
}

/* User Section */
.user-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 30rpx 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.user-info {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
}

.user-details {
  flex: 1;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.user-plan {
  font-size: 24rpx;
  color: #666;
  background: #f0f0f0;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  display: inline-block;
}

.user-quota {
  background: #e8f5e8;
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
}

.quota-text {
  font-size: 26rpx;
  color: #4CAF50;
  font-weight: 600;
}

/* Login Section */
.login-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 30rpx;
}

.login-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.login-subtitle {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 40rpx;
}

.login-btn {
  background: linear-gradient(45deg, #4CAF50, #45a049);
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* Quick Actions */
.quick-actions {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.action-buttons {
  margin-top: 20rpx;
}

.btn-primary, .btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-radius: 12rpx;
  padding: 24rpx;
  border: none;
  margin-bottom: 20rpx;
}

.btn-large {
  padding: 32rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.btn-primary {
  background: linear-gradient(45deg, #4CAF50, #45a049);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.3);
}

.btn-secondary {
  background: #f5f5f5;
  color: #333;
  border: 2rpx solid #e0e0e0;
}

.btn-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.secondary-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

/* Section Titles */
.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.title-more {
  font-size: 26rpx;
  color: #4CAF50;
}

/* Recent Translations */
.recent-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.recent-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.recent-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.recent-item:active {
  transform: scale(0.98);
  background: #e9ecef;
}

.item-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
}

.item-content {
  flex: 1;
}

.item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
  word-break: break-all;
}

.item-subtitle {
  font-size: 24rpx;
  color: #666;
}

.item-status {
  background: #e8f5e8;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.status-text {
  font-size: 22rpx;
  color: #4CAF50;
  font-weight: 600;
}

/* Features Section */
.features-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.features-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30rpx;
  margin-top: 20rpx;
}

.feature-item {
  text-align: center;
  padding: 30rpx 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.feature-item:active {
  transform: scale(0.98);
  background: #e9ecef;
}

.feature-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 20rpx;
}

.feature-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

/* Upgrade Section */
.upgrade-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.upgrade-prompt {
  text-align: center;
}

.upgrade-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.upgrade-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.upgrade-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 30rpx;
}

.upgrade-btn {
  background: linear-gradient(45deg, #ff9800, #f57c00);
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* Footer Section */
.footer-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 40rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.footer-links {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 30rpx;
}

.footer-link {
  font-size: 26rpx;
  color: #4CAF50;
}

.footer-info {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.version-text, .copyright-text {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}

/* Button Active States */
.btn-primary:active, .btn-secondary:active, .login-btn:active,
.upgrade-btn:active {
  transform: scale(0.98);
  opacity: 0.8;
}

/* Responsive Design */
@media (max-width: 400rpx) {
  .container {
    padding: 15rpx;
  }
  
  .header-section, .login-section, .quick-actions,
  .recent-section, .features-section, .upgrade-section,
  .footer-section {
    padding: 30rpx 25rpx;
  }
  
  .features-grid {
    grid-template-columns: 1fr;
    gap: 20rpx;
  }
  
  .secondary-actions {
    grid-template-columns: 1fr;
    gap: 15rpx;
  }
  
  .footer-links {
    gap: 20rpx;
  }
}