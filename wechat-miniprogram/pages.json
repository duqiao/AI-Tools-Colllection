{
  "pages": [
    {
      "path": "src/pages/index/index",
      "style": {
        "navigationBarTitleText": "媒体翻译助手",
        "navigationBarBackgroundColor": "#4CAF50",
        "navigationBarTextStyle": "white",
        "backgroundColor": "#f5f5f5"
      }
    },
    {
      "path": "src/pages/upload/index",
      "style": {
        "navigationBarTitleText": "上传文件",
        "navigationBarBackgroundColor": "#4CAF50",
        "navigationBarTextStyle": "white",
        "backgroundColor": "#f5f5f5",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "src/pages/result/index",
      "style": {
        "navigationBarTitleText": "翻译结果",
        "navigationBarBackgroundColor": "#4CAF50",
        "navigationBarTextStyle": "white",
        "backgroundColor": "#f5f5f5"
      }
    },
    {
      "path": "src/pages/profile/index",
      "style": {
        "navigationBarTitleText": "个人中心",
        "navigationBarBackgroundColor": "#4CAF50",
        "navigationBarTextStyle": "white",
        "backgroundColor": "#f5f5f5"
      }
    },
    {
      "path": "src/pages/history/index",
      "style": {
        "navigationBarTitleText": "翻译历史",
        "navigationBarBackgroundColor": "#4CAF50",
        "navigationBarTextStyle": "white",
        "backgroundColor": "#f5f5f5",
        "enablePullDownRefresh": true
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "媒体翻译助手",
    "navigationBarBackgroundColor": "#4CAF50",
    "backgroundColor": "#f5f5f5"
