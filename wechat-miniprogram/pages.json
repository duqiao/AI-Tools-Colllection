    "list": [
      {
        "pagePath": "src/pages/index/index",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-active.png",
        "text": "首页"
      },
      {
        "pagePath": "src/pages/upload/index",
        "iconPath": "static/tabbar/upload.png",
        "selectedIconPath": "static/tabbar/upload-active.png",
        "text": "翻译"
      },
      {
        "pagePath": "src/pages/history/index",
        "iconPath": "static/tabbar/history.png",
        "selectedIconPath": "static/tabbar/history-active.png",
        "text": "历史"
      },
      {
        "pagePath": "src/pages/profile/index",
        "iconPath": "static/tabbar/profile.png",
        "selectedIconPath": "static/tabbar/profile-active.png",
        "text": "我的"
      }
    ]
  },
  "uniIdRouter": {},
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u-(.*)": "uview-plus/components/u-$1/u-$1.vue"
