# Environment Configuration for AI Media Translation Backend

# Application Settings
NODE_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/ai_media_translation
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-very-secure
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production-very-secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# File Upload Configuration
UPLOAD_DIR=./uploads
TEMP_DIR=./temp
MAX_FILE_SIZE=104857600  # 100MB
MAX_AUDIO_SIZE=52428800   # 50MB  
MAX_VIDEO_SIZE=104857600  # 100MB

# Supported File Types
ALLOWED_AUDIO_TYPES=["audio/mpeg","audio/wav","audio/x-wav","audio/mp4","audio/ogg","audio/flac","audio/aac"]
ALLOWED_VIDEO_TYPES=["video/mp4","video/quicktime","video/x-msvideo","video/x-matroska","video/webm"]

# Speech-to-Text Configuration
STT_PROVIDER=openai  # openai, google
OPENAI_API_KEY=your-openai-api-key-here
WHISPER_MODEL=base  # tiny, base, small, medium, large
GOOGLE_SPEECH_API_KEY=your-google-speech-api-key-here

# Translation Service Configuration
TRANSLATION_PROVIDER=google  # google, deepl
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key-here
DEEPL_API_KEY=your-deepl-api-key-here

# User Quotas
GUEST_DAILY_LIMIT=3
FREE_DAILY_LIMIT=10
PREMIUM_DAILY_LIMIT=1000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Processing Configuration
MAX_CONCURRENT_JOBS=3
JOB_TIMEOUT_MINUTES=30

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:8094","http://localhost:19006","exp://localhost:19000"]

# Logging
LOG_LEVEL=INFO