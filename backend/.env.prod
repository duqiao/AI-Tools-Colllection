# Production environment file
NODE_ENV=production
DEBUG=false
DATABASE_TYPE=postgres

# Database Configuration
POSTGRES_URI=postgresql://postgres:prod123456@postgres:5432/ai_media_translation

# Security Configuration (CHANGE THESE IN PRODUCTION)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-strong-random-key
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-production-use-strong-random-key

# API Configuration
HOST=0.0.0.0
PORT=8000

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
WHISPER_MODEL=base

# File Upload Configuration
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=104857600
MAX_AUDIO_SIZE=52428800
MAX_VIDEO_SIZE=104857600

# CORS Configuration
CORS_ORIGINS=["https://your-api-domain.com", "https://your-staging-domain.com"]

# Performance Configuration
MAX_CONCURRENT_JOBS=100
PROCESSING_TIMEOUT=1800000
DB_POOL_SIZE=20

# Logging
LOG_LEVEL=info