# Development environment file
NODE_ENV=development
DEBUG=true
DATABASE_TYPE=mongodb

# Database Configuration
MONGODB_URI=mongodb://admin:dev123456@localhost:27018/ai_media_translation?authSource=admin
REDIS_URL=redis://:dev123456@localhost:6379/0

# Security Configuration
JWT_SECRET=dev-secret-key-change-in-production
JWT_REFRESH_SECRET=dev-refresh-key-change-in-production

# API Configuration
HOST=0.0.0.0
PORT=8000

# Speech-to-Text Configuration
STT_PROVIDER=deepseek_api
DEEPSEEK_API_KEY=sk-bd6104f6dfab45dc8a182d5a8568fe56
OPENAI_API_KEY=your_openai_api_key_here
WHISPER_MODEL=base

# File Upload Configuration
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=104857600
MAX_AUDIO_SIZE=52428800
MAX_VIDEO_SIZE=104857600

# CORS Configuration
CORS_ORIGINS=["http://localhost:19006", "http://127.0.0.1:19006", "exp://localhost:19000", "http://127.0.0.1:8000", "http://localhost:8000", "http://localhost:8081", "http://127.0.0.1:8081", "*"]

# Performance Configuration
MAX_CONCURRENT_JOBS=10
PROCESSING_TIMEOUT=1800000
DB_POOL_SIZE=10

# Logging
LOG_LEVEL=debug